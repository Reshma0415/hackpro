# ==============================================================================
# CANDIDATE TRUST INTELLIGENCE PLATFORM - ENVIRONMENT CONFIGURATION
# Enterprise Real 3-Step Verification Flow (Phone OTP -> Email OTP -> Aadhaar OTP)
# ==============================================================================

# Server & Application Environment
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
JWT_SECRET=super_secret_jwt_hmac_sha256_signing_key_replace_in_production_2026

# Database Configurations
MONGO_URI=mongodb://127.0.0.1:27017/candidate_trust_db
DB_PATH=./candidate_trust.sqlite
UPLOAD_DIR=./uploads

# ------------------------------------------------------------------------------
# STEP 1: REAL MOBILE SMS OTP PROVIDER CONFIGURATION
# Supported SMS_PROVIDER options: twilio | msg91 | fast2sms
# ------------------------------------------------------------------------------
SMS_PROVIDER=twilio

# --- Option A: Twilio (Twilio Verify API or Programmable SMS) ---
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token
# Twilio Verify Service SID (recommended) OR Twilio Phone Number (+1XXXXXXXXXX / +91XXXXXXXXXX)
TWILIO_VERIFY_SERVICE_SID=VAXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_PHONE_NUMBER=+1234567890

# --- Option B: MSG91 (Indian DLT / Transactional SMS) ---
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_TEMPLATE_ID=your_msg91_flow_or_template_id

# --- Option C: Fast2SMS (Indian SMS Gateway) ---
FAST2SMS_API_KEY=your_fast2sms_api_key

# ------------------------------------------------------------------------------
# STEP 2: REAL EMAIL OTP PROVIDER CONFIGURATION (NODEMAILER SMTP)
# Used for Real Email OTP verification (Gmail App Password, Resend, SendGrid)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-organization-email@gmail.com
SMTP_PASS=your-google-16-character-app-password
EMAIL_FROM=Candidate Trust Security <no-reply@candidatetrust.com>

# ------------------------------------------------------------------------------
# STEP 3: REAL AADHAAR KYC PROVIDER CONFIGURATION (LICENSED OKYC APIs)
# Supported AADHAAR_PROVIDER options: surepass | setu
# ------------------------------------------------------------------------------
AADHAAR_PROVIDER=surepass

# --- Option A: Surepass (https://surepass.io) ---
SUREPASS_API_KEY=your_surepass_bearer_api_token
SUREPASS_API_URL=https://kyc-api.surepass.io

# --- Option B: Setu (https://setu.co) ---
SETU_CLIENT_ID=your_setu_client_id
SETU_CLIENT_SECRET=your_setu_client_secret
SETU_PRODUCT_INSTANCE_ID=your_setu_product_instance_id
SETU_API_URL=https://okyc.setu.co

# ------------------------------------------------------------------------------
# PLATFORM SECURITY FLAGS
# ------------------------------------------------------------------------------
DEMO_MODE=false
